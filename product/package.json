{
  "scripts": {
    "build": "npm run _clear-build && npm run _build-main && npm run _copy-asssets-to-dist && ng build --configuration production",
    "_build-main": "cd ./main-src && vite build && cd ../",
    "_clear-build": "node build-scripts/clear-build.js",
    "start": "tsc --project main-src/tsconfig.json && npm run _copy-asssets-to-dist && concurrently \"cross-env NODE_ENV=develop electron ./dist\" \"ng build --watch\"",
    "lint": "eslint \"{src,main-src}/**/*.{ts,html}\" && tsc --project main-src/tsconfig.json",
    "format": "eslint \"{src,main-src}/**/*.{ts,html}\" --fix && prettier --write \"{src,main-src}/**/*.{ts,scss,html}\"",
    "make-icon": "node build-scripts/make-icon.js",
    "release-darwin": "npm run _prebuild-darwin && npm run _package-darwin",
    "release-mac-app-store": "npm run _prebuild-darwin && npm run _package-mac-app-store",
    "release-win32": "npm run _prebuild-win32 && npm run _package-win32",
    "release-windows-store": "npm run _prebuild-win32 && npm run _package-windows-store",
    "_prebuild-darwin": "npm run build && node build-scripts/for-mac-prebuild.js",
    "_prebuild-win32": "npm run build && node build-scripts/for-windows-prebuild.js",
    "_package-darwin": "export DEBUG=electron-osx-sign && node build-scripts/for-mac-packaging.js -- 'development'",
    "_package-mac-app-store": "export DEBUG=electron-osx-sign && node build-scripts/for-mac-packaging.js -- 'distribution'",
    "_package-win32": "node build-scripts/for-windows-packaging.js",
    "_package-windows-store": "node build-scripts/for-windows-store-packaging.js",
    "_copy-asssets-to-dist": "node build-scripts/copy-assets-to-dist.js",
    "test": "vitest"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "18.0.1",
    "@angular/common": "18.0.1",
    "@angular/compiler": "18.0.1",
    "@angular/core": "18.0.1",
    "@angular/forms": "18.0.1",
    "@angular/platform-browser": "18.0.1",
    "@angular/platform-browser-dynamic": "18.0.1",
    "bootstrap": "^4.3.1",
    "core-js": "^2.6.12",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.1.4",
    "electron": "^30.0.9",
    "electron-fetch": "^1.9.1",
    "font-awesome": "^4.7.0",
    "jquery": "^3.6.0",
    "popper.js": "^1.15.0",
    "rxjs": "^6.6.7",
    "tslib": "^2.0.0",
    "vite": "^2.8.0",
    "zone.js": "~0.14.6"
  },
  "devDependencies": {
    "@angular-devkit/core": "18.0.2",
    "@angular-eslint/builder": "18.0.1",
    "@angular-eslint/eslint-plugin": "18.0.1",
    "@angular-eslint/eslint-plugin-template": "18.0.1",
    "@angular-eslint/schematics": "18.0.1",
    "@angular-eslint/template-parser": "18.0.1",
    "@angular/build": "^18.0.2",
    "@angular/cli": "18.0.2",
    "@angular/compiler-cli": "18.0.1",
    "@angular/language-service": "18.0.1",
    "@electron/osx-sign": "^1.3.0",
    "@electron/packager": "^18.3.2",
    "@electron/universal": "^1.3.4",
    "@types/bootstrap": "^5.2.10",
    "@types/createjs": "^0.0.29",
    "@types/jquery": "^3.5.30",
    "@types/node": "^16.4.14",
    "@typescript-eslint/eslint-plugin": "7.11.0",
    "@typescript-eslint/parser": "7.11.0",
    "@typescript-eslint/utils": "^8.0.0-alpha.20",
    "concurrently": "^8.2.2",
    "cross-env": "^5.2.1",
    "del": "^4.1.1",
    "electron-windows-store": "^2.1.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "^8.3.0",
    "eslint-plugin-import": "latest",
    "eslint-plugin-jsdoc": "latest",
    "eslint-plugin-prefer-arrow": "latest",
    "eslint-plugin-prettier": "^4.0.0",
    "husky": "^8.0.3",
    "icon-gen": "^4.0.0",
    "mkdirp": "^0.5.5",
    "prettier": "^2.5.1",
    "sharp": "0.33.4",
    "typescript": "^5.4.5",
    "vitest": "0.6.1"
  },
  "husky": {
    "hooks": {
      "pre-commit": "npm run lint"
    }
  }
}
